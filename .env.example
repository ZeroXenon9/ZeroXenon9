# Binance (public OHLCV fetch works without keys; required only for trading)
BINANCE_API_KEY=
BINANCE_SECRET=

# Telegram bot for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CoinMarketCap (optional – enables sector filtering and top-N coin discovery)
CMC_API_KEY=

# Comma-separated CMC category slugs to scan (leave blank = scan top coins by mcap)
CMC_SECTORS=

# Number of top coins to scan when no sectors are set
TOP_COINS_LIMIT=100

# Binance quote currency
QUOTE_CURRENCY=USDT

# Minimum FVG gap as fraction of price (backtest optimisation target)
MIN_FVG_GAP_PCT=0.002
